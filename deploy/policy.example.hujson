// A fragment to merge into your existing tailnet policy, not a whole policy
// to paste over it: add these entries to your own nodeAttrs, tagOwners and
// grants. tag:prod-worker stands for whichever tag your senders have.
{
  // Only for `tsrelay serve --funnel`: lets the relay serve public hooks on
  // the internet. Leave it out to keep the relay tailnet-only.
  "nodeAttrs": [
    {"target": ["tag:tsrelay"], "attr": ["funnel"]},
  ],
  "tagOwners": {
    "tag:tsrelay": ["autogroup:admin"],
    "tag:prod-worker": ["autogroup:admin"],
  },
  "grants": [
    // Who may receive callbacks: run `tsrelay http` or use the UI.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:tsrelay"],
      "ip": ["tcp:443"],
      "app": {
        // public lets these users make hooks reachable from the internet
        // (only with --funnel); drop it to keep hooks tailnet-only.
        "tsrelay.mazetti.me/cap/relay": [{"roles": ["receiver"], "public": true}],
      },
    },
    // Who may send callbacks to a hook.
    {
      "src": ["tag:prod-worker"],
      "dst": ["tag:tsrelay"],
      "ip": ["tcp:443"],
      "app": {
        "tsrelay.mazetti.me/cap/relay": [{"roles": ["sender"]}],
      },
    },
  ],
}
