{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist", "pnpm-lock.yaml", "src/test/fixtures/*.json"],
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": { "ignoreCase": true, "newlinesBetween": false, "order": "asc" },
  "sortTailwindcss": { "stylesheet": "./src/index.css" }
}
