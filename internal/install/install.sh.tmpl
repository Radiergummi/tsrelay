#!/bin/sh
# Installs the tsrelay CLI ({{.Version}}) to ~/.local/bin. Run it with:
#   curl -fsSL {{.RelayURL}}/install.sh | sh
set -eu

base='{{.AssetBase}}'
bindir="$HOME/.local/bin"

fail() {
	echo "tsrelay install: $*" >&2
	exit 1
}

case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=darwin ;;
*) fail "no build for $(uname -s); see {{.RelayURL}}/cli" ;;
esac
case "$(uname -m)" in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
*) fail "no build for $(uname -m); see {{.RelayURL}}/cli" ;;
esac
name="tsrelay_${os}_${arch}"

if command -v curl >/dev/null 2>&1; then
	fetch() { curl -fsSL -o "$2" "$1"; }
elif command -v wget >/dev/null 2>&1; then
	fetch() { wget -qO "$2" "$1"; }
else
	fail "needs curl or wget"
fi
if command -v sha256sum >/dev/null 2>&1; then
	checksum() { sha256sum "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
	checksum() { shasum -a 256 "$1" | cut -d' ' -f1; }
else
	fail "needs sha256sum or shasum"
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
echo "Downloading $name ({{.Version}})..."
fetch "$base/$name" "$tmp/tsrelay" || fail "could not download $base/$name"
fetch "$base/$name.sha256" "$tmp/sum" || fail "could not download $base/$name.sha256"
[ "$(cut -d' ' -f1 "$tmp/sum")" = "$(checksum "$tmp/tsrelay")" ] || fail "checksum mismatch for $name; nothing was installed"

chmod +x "$tmp/tsrelay"
mkdir -p "$bindir"
mv -f "$tmp/tsrelay" "$bindir/tsrelay"
"$bindir/tsrelay" --version
echo "Installed to $bindir/tsrelay"

case ":$PATH:" in
*":$bindir:"*) ;;
*)
	echo
	echo "$bindir is not on your PATH. Add this to your shell profile:"
	echo "  export PATH=\"$bindir:\$PATH\""
	;;
esac
{{- if .RelayHint}}
echo
echo "This relay is not at the CLI's default address. Add this to your shell profile:"
echo "  export TSRELAY_RELAY={{.RelayHint}}"
{{- end}}
