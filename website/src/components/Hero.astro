---
import {Activity, Globe, KeyRound, Network, RotateCcw, Waypoints} from "@lucide/astro";
import {latestVersion} from "../lib/release";

interface Props {
    description: string;
}

const {description} = Astro.props;
const version = await latestVersion();

const secondaryButtonClass =
    "inline-flex items-center rounded-lg border px-4 py-2 text-sm font-medium text-foreground hover:bg-accent transition-colors";

/**
 * The session the hero shows is the CLI's real output, from the getting
 * started guide: the URL to configure, the hook, and calls as they arrive.
 */
const calls = [
    {time: "14:02:11", method: "POST", path: "/payments/done", status: 200, duration: "12ms", sender: "tag:prod-worker"},
    {time: "14:02:19", method: "POST", path: "/payments/refunded", status: 200, duration: "9ms", sender: "tag:prod-worker"},
    {time: "14:03:02", method: "POST", path: "/invoices/sent", status: 404, duration: "4ms", sender: "tag:billing"},
    {time: "14:03:40", method: "POST", path: "/payments/done", status: 200, duration: "15ms", sender: "tag:prod-worker"},
];

const features = [
    {
        href: "/access-control",
        icon: KeyRound,
        title: "Access from your tailnet policy",
        text: "Grants decide who may send and who may receive. There are no tokens to hand out, and production never gets a route to a laptop.",
    },
    {
        href: "/hooks",
        icon: Waypoints,
        title: "Hooks you create, nothing else",
        text: "The relay forwards only to hooks their owners made. It never intercepts a service's traffic.",
    },
    {
        href: "/web-ui",
        icon: RotateCcw,
        title: "Inspect and replay every call",
        text: "Watch calls arrive live, read their headers and bodies, replay them, or copy one as curl.",
    },
    {
        href: "/hooks#hook-settings",
        icon: Network,
        title: "Held while you reconnect",
        text: "A call waits for your tunnel to come back instead of failing, within limits you set per hook.",
    },
    {
        href: "/hooks#public-hooks",
        icon: Globe,
        title: "Public only when you say so",
        text: "Stripe or GitHub can reach a hook through Tailscale Funnel, once both the operator and the hook's owner opt in.",
    },
    {
        href: "/observability",
        icon: Activity,
        title: "Audited and traced",
        text: "An audit log, Prometheus metrics and OpenTelemetry traces that span sender, relay and your app.",
    },
];
---
<section class="px-6 pt-16 pb-12 md:px-12 md:pt-24 lg:px-16" data-pagefind-ignore>
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
        <header class="max-w-xl">
            <h1 class="text-4xl font-semibold tracking-tight text-balance md:text-5xl">
                Callbacks from your tailnet, delivered to localhost
            </h1>
            <p class="mt-5 text-md leading-relaxed text-muted-foreground text-pretty">{description}</p>

            <div class="mt-8 flex flex-wrap gap-3">
                <a
                    href="/getting-started"
                    class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
                >
                    Get started
                </a>
                <a href="/running-a-relay" class={secondaryButtonClass}>Run a relay</a>
                <a href="/download" class={secondaryButtonClass}>Download {version}</a>
            </div>
        </header>

        <figure class="min-w-0 overflow-hidden rounded-xl border bg-code-background shadow-popover" aria-label="A tsrelay http session forwarding calls to port 8080">
            <div class="flex items-center gap-1.5 border-b px-4 py-2.5" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-border"></span>
                <span class="size-2.5 rounded-full bg-border"></span>
                <span class="size-2.5 rounded-full bg-border"></span>
            </div>
            <pre class="overflow-x-auto p-5 font-mono text-xs leading-relaxed text-code-foreground md:text-sm"><code><span class="text-muted-foreground">$</span> tsrelay http 8080
<span class="text-muted-foreground">tsrelay  forwarding to http://localhost:8080</span>
<span class="font-medium text-foreground">https://tsrelay.example.ts.net/~moritz/amber-otter-lamp</span>
<span class="text-muted-foreground">hook h_3k2  ephemeral  channel default</span>
connected
{calls.map(({time, method, path, status, duration, sender}, index) => (
<span class="terminal-call" style={`--call-index: ${index}`}><span class="text-muted-foreground">{time}</span> {method} {path} → <span class:list={[status < 400 ? "text-status-ok" : "text-status-warn"]}>{status}</span>  <span class="text-muted-foreground">{duration}  {sender}</span>
</span>
))}</code></pre>
        </figure>
    </div>
</section>

<section class="border-t px-6 py-14 md:px-12 lg:px-16" aria-labelledby="features-heading" data-pagefind-ignore>
    <h2 id="features-heading" class="sr-only">Features</h2>
    <ul class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {features.map(({href, icon: Icon, title, text}) => (
            <li>
                <a href={href} class="group block">
                    <Icon class="size-5 text-active" aria-hidden="true" />
                    <h3 class="mt-3 text-base font-semibold group-hover:text-active transition-colors">{title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{text}</p>
                </a>
            </li>
        ))}
    </ul>
</section>

<style>
    /*
     * The calls arrive one after another once the page has loaded, as they
     * would in the terminal; without motion they are simply there.
     */
    @media (prefers-reduced-motion: no-preference) {
        .terminal-call {
            animation: call-arrives 240ms ease-out both;
            animation-delay: calc(600ms + var(--call-index) * 700ms);
        }
    }

    @keyframes call-arrives {
        from {
            opacity: 0;
        }
    }
</style>
