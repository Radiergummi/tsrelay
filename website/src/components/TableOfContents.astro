---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter(({depth}) => depth >= 2 && depth <= 3);
---
{filtered.length > 0 && (
  <aside class="hidden xl:block print:hidden select-none w-48 shrink-0 rail py-8 pr-6 lg:pr-8 pl-4" aria-label="On this page">
    <h3 class="text-2xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">
      On this page
    </h3>
    <ul id="toc-list" class="flex flex-col gap-1.5 text-sm border-l pl-3">
      {filtered.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="block py-0.5 leading-snug text-muted-foreground transition-colors hover:text-foreground data-nested:pl-3 data-active:font-medium data-active:text-active"
            data-heading={heading.slug}
            data-nested={heading.depth === 3 || undefined}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script is:inline>
  // The client router runs this once, so it watches each page's headings from
  // `astro:page-load` and lets go of the previous page's.
  if (!window.__tocInitialized) {
    window.__tocInitialized = true;

    let observer = null;

    document.addEventListener("astro:page-load", () => {
      observer?.disconnect();
      observer = null;

      const links = document.querySelectorAll("#toc-list a[data-heading]");
      const headings = Array.from(links)
        .map((link) => ({ link, target: document.getElementById(link.dataset.heading) }))
        .filter(({ target }) => target);

      if (!headings.length) {
        return;
      }

      let current = null;

      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) {
            continue;
          }

          const match = headings.find(({ target }) => target === entry.target);

          if (match) {
            current?.removeAttribute("data-active");
            match.link.setAttribute("data-active", "");
            current = match.link;
          }
        }
      }, { rootMargin: "-80px 0px -80% 0px" });

      for (const { target } of headings) {
        observer.observe(target);
      }
    });
  }
</script>
