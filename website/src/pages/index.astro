---
import {getEntry, render} from "astro:content";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MermaidViewport from "../components/MermaidViewport.astro";
import {markdownFor} from "../lib/pages";
import "../styles/global.css";

const home = await getEntry("docs", "index");

if (!home) {
    throw new Error("no docs/index entry; the home page takes its description and body from it");
}

const {Content} = await render(home);
const markdownUrl = markdownFor("/");
---
<html lang="en">
<head>
    <Head title="tsrelay" description={home.data.description} isHome alternate={{href: markdownUrl}} />
</head>
<body class="min-h-screen">
<Header currentPath="/" />
<div class="mx-auto max-w-shell">
    <main id="main-content" class="min-w-0">
        <Hero description={home.data.description} />

        <section class="border-t px-6 py-14 md:px-12 lg:px-16">
            <div class="prose">
                <Content />
            </div>
        </section>
    </main>
</div>
<MermaidViewport />
</body>
</html>
