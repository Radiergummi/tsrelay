{
  "name": "tsrelay-website",
  "version": "1.0.0",
  "private": true,
  "description": "The tsrelay website and documentation, at https://tsrelay.mazetti.me.",
  "repository": "https://github.com/Radiergummi/tsrelay",
  "type": "module",
  "scripts": {
    "sync-assets": "mkdir -p public/api && cp ../internal/api/openapi.yaml public/api/openapi.yaml && cp node_modules/@scalar/api-reference/dist/browser/standalone.js public/scalar.js",
    "prebuild": "pnpm sync-assets",
    "predev": "pnpm sync-assets",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lucide/astro": "^1.60.0",
    "@scalar/api-reference": "^1.75.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "astro": "^7.4.1",
    "fontkit": "^2.0.4",
    "pagefind": "^1.5.2",
    "pele": "^1.8.0",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/unist": "^3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.10.1"
}
